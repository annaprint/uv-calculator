# Copy to .env on the server and fill in real values.
# /opt/uv-calc/.env is read by the systemd unit (EnvironmentFile=).

PORT=3001
NODE_ENV=production

# 32 random bytes hex; generate with: openssl rand -hex 32
SESSION_SECRET=

# nginx terminates TLS, so the cookie must be marked secure.
COOKIE_SECURE=true

# Used by seed.js (one-time first-admin bootstrap). Remove or empty
# ADMIN_PASS after the first login + password change.
ADMIN_EMAIL=annaprint@mail.ru
ADMIN_PASS=
ADMIN_NAME=Анна

# Backup retention (days). Defaults to 30 if unset.
BACKUP_RETENTION_DAYS=30
